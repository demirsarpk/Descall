# === Frontend (Vite) ===
VITE_API_BASE_URL=https://des-call.onrender.com
# Yerel geliştirme:
# VITE_API_BASE_URL=http://localhost:3000

# === Backend (frontend/backend — yerel çalıştırma) ===
# Supabase: Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key-not-anon...

JWT_SECRET=local-dev-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
PORT=3000

# WebRTC TURN (optional — improves NAT/VPN connectivity)
# TURN_URL=turn:your.turn.server:3478?transport=udp
# TURN_USERNAME=...
# TURN_CREDENTIAL=...
# Or full JSON array:
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:...","username":"...","credential":"..."}]

# Frontend optional override (JSON array):
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
