# API Configuration
VITE_API_BASE_URL=https://des-call.onrender.com

# Optional: Override for local development
# VITE_API_BASE_URL=http://localhost:3000

# Google Sign-In (OAuth 2.0 / Google Identity Services)
# Create a Web client in Google Cloud Console → APIs & Services → Credentials
# Authorized JavaScript origins: http://localhost:5173, https://des-call.onrender.com
# The same Client ID is used by the Vite frontend and Express backend token verification.
VITE_GOOGLE_CLIENT_ID=
# Backend can also read GOOGLE_CLIENT_ID (preferred in production secrets)
# GOOGLE_CLIENT_ID=